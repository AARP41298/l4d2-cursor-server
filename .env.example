# Copia a .env y cambia el RCON.
SRCDS_HOSTNAME=Los 8 de Mercy
SRCDS_MAXPLAYERS=8
SRCDS_STARTMAP=c8m1_apartment
SRCDS_GAMEMODE=coop
# Host (Windows) y srcds (contenedor). Mismos = Steam anuncia el puerto correcto.
# 27016 evita el choque con left4dead2.exe (UDP 27015) en esta PC.
DOCKER_EXTERNO=27016
DOCKER_INTERNO=27016
SRCDS_REGION=255
SRCDS_RCONPW=cambia-esto-ya
SRCDS_PW=
SRCDS_STEAMGROUP=0
FORCE_ADDON_INSTALL=0
# Opcional: si SteamCMD sigue en "Missing configuration" / "Invalid platform",
# usa una cuenta que tenga L4D2 (mejor una secundaria, sin Steam Guard si puedes).
STEAM_USER=anonymous
STEAM_PASS=
STEAM_GUARD=
# Mapas Workshop. Colección del gist (Deathcraft, Hive, RE1–3, Tank Challenge, Big Wat).
# Vacío = no baja mapas. IDs sueltos o colecciones, separados por coma.
WORKSHOP_IDS=2233971331
FORCE_WORKSHOP_UPDATE=0
